PORT=7777
JWT_SECRET=your_jwt_secret_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hackpair
NODE_ENV=development

# Email Configuration (Gmail SMTP via Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=HackPair <your-email@gmail.com>

# Resend API Configuration (Alternative for custom domains)
RESEND_API_KEY=re_your_api_key_here

# Frontend URL
FRONTEND_URL=http://localhost:5173
